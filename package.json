{
  "name": "recoup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "bun run src/eval/run.ts",
    "showcase": "bun run src/demo/showcase.ts",
    "demo": "bun run showcase && cd web && bun install && bun run dev",
    "demo:build": "bun run showcase && cd web && bun install && bun run build",
    "test": "bun test tests/",
    "typecheck": "tsc --noEmit",
    "test:web": "cd web && bun test tests/",
    "razorpay:webhook": "bun run src/razorpay/server.ts",
    "razorpay:link": "bun run src/razorpay/createLink.ts",
    "razorpay:status": "bun run src/razorpay/status.ts",
    "deploy:pages": "bash scripts/deploy-pages.sh"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}